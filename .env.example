# Copie ce fichier en .env et adapte les valeurs si besoin — seules les clés API sont
# obligatoires, les autres valeurs ont des défauts dans server.js et docker-compose.yml.

# Clés API (obligatoire pour TMDB, optionnelle pour OMDb)
#  - TMDB : https://www.themoviedb.org/settings/api  (clé « API Key », 32 caractères)
#  - OMDb : https://www.omdbapi.com/apikey.aspx       (8 caractères ; active les notes IMDb)
TMDB_API_KEY=
OMDB_API_KEY=

# Port d'écoute du serveur CineForest
PORT=2000

# URL interne du serveur Ollama (ne jamais exposer cette URL au navigateur)
#  - lancement direct (node server.js) : http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434

# Docker uniquement : URL d'Ollama vue depuis le conteneur (remplace OLLAMA_URL)
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# Docker uniquement : adresse IP de la machine sur laquelle exposer le port
# (127.0.0.1 = accessible seulement en local ; mets l'IP de ton réseau privé, ex. Tailscale, si besoin)
BIND_IP=127.0.0.1
